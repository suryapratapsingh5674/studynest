{
  "name": "studynest-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "StudyNest: AI-Powered Study Companion",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "test:ai": "cd server && npm run test:ai",
    "test:phase2": "cd server && npm run test:phase2",
    "test:phase3": "cd server && npm run test:phase3",
    "test:phase4": "cd server && npm run test:phase4",
    "test:phase5": "cd server && npm run test:phase5",
    "test:phase6": "cd server && npm run test:phase6",
    "test:phase7": "cd server && npm run test:phase7",
    "test:phase8": "cd server && npm run test:phase8",
    "test:eval": "cd server && npm run test:eval",
    "mcp": "node mcp-server/src/index.js",
    "qdrant:up": "docker compose up -d",
    "qdrant:down": "docker compose down",
    "build:client": "cd client && npm run build"
  }
}

