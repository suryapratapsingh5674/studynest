# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/studynest

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=studynest_documents

# Cloudflare Workers AI Credentials
# Get Account ID and API Token from Cloudflare Dashboard -> Workers & Pages -> Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare Workers AI OpenAI-Compatible Base URL:
# https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your_cloudflare_account_id/ai/v1

# Models & Embedding Configuration
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.2-3b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

